{
	"name": "n8n-nodes-mailgraf",
	"version": "0.1.2",
	"description": "n8n community node for MailGraf: create and update contacts, manage lists, send events, and start workflows from MailGraf webhooks.",
	"license": "MIT",
	"homepage": "https://mailgraf.com",
	"keywords": [
		"n8n-community-node-package",
		"mailgraf",
		"email marketing",
		"newsletter"
	],
	"author": {
		"name": "MailGraf",
		"email": "info@mailgraf.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MailGraf/n8n-mailgraf.git"
	},
	"bugs": {
		"url": "https://github.com/MailGraf/n8n-mailgraf/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MailGrafApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/MailGraf/MailGraf.node.js",
			"dist/nodes/MailGrafTrigger/MailGrafTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.48.5",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
